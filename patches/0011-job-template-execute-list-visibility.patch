+@pytest.mark.django_db
+def test_job_template_list_team_execute_survives_missing_implied_view(user, setup_managed_roles, get):
+    """Execute remains sufficient for list visibility if its implied-view
+    evaluation is missing from persisted RBAC data."""
+    org = Organization.objects.create(name='jt-list-team-org')
+    team = Team.objects.create(name='jt-list-team', organization=org)
+    team_user = user('jt-list-team-member')
+    RoleDefinition.objects.get(name='Team Member').give_permission(team_user, team)
+
+    inventory = org.inventories.create(name='jt-list-inventory')
+    project = Project.objects.create(name='jt-list-project', organization=org)
+    executable_jt = JobTemplate.objects.create(name='jt-list-executable', project=project, inventory=inventory, organization=org)
+    hidden_jt = JobTemplate.objects.create(name='jt-list-hidden', project=project, inventory=inventory, organization=org)
+
+    execute_rd = RoleDefinition.objects.get(name='JobTemplate Execute')
+    execute_rd.give_permission(team, executable_jt)
+
+    # Reproduce F180's persisted state: the managed role definition is correct
+    # and execute is evaluated, but its implied view evaluation is absent.
+    team_member_role_ids = team_user.role_assignments.values_list('object_role_id', flat=True)
+    RoleEvaluation.objects.filter(
+        role_id__in=team_member_role_ids,
+        codename='view_jobtemplate',
+        object_id=executable_jt.pk,
+    ).delete()
+
+    response = get(reverse('api:job_template_list'), team_user)
+    assert response.status_code == 200
+    result_ids = [result['id'] for result in response.data['results']]
+    assert executable_jt.pk in result_ids
+    assert hidden_jt.pk not in result_ids
+

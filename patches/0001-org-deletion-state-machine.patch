+++ b/awx/main/models/org_deletion.py
@@ -0,0 +1,97 @@
+# Copyright (c) 2026 Automation Platform contributors
+# ADR-0001 increment 1: organization deletion is an observable, resumable
+# state machine, not a synchronous transaction that strands children.
+
+from django.db import models
+from django.utils.translation import gettext_lazy as _
+
+__all__ = ['OrganizationDeletion']
+
+
+class OrganizationDeletion(models.Model):
+    """A requested organization deletion and its progress.
+
+    DELETE /api/v2/organizations/N/ creates (or resumes) one of these and
+    returns 202; the reaper task (awx.main.tasks.org_deletion) drives it to a
+    terminal state. The record survives the organization row (SET_NULL plus
+    snapshots) so `complete` and `failed` remain observable after the fact.
+    """
+
+    STATE_PENDING = 'pending'
+    STATE_CANCELLING_JOBS = 'cancelling-jobs'
+    STATE_REAPING = 'reaping'
+    STATE_COMPLETE = 'complete'
+    STATE_FAILED = 'failed'
+    STATES = [
+        (STATE_PENDING, _('Pending')),
+        (STATE_CANCELLING_JOBS, _('Cancelling jobs')),
+        (STATE_REAPING, _('Reaping')),
+        (STATE_COMPLETE, _('Complete')),
+        (STATE_FAILED, _('Failed')),
+    ]
+    TERMINAL_STATES = (STATE_COMPLETE, STATE_FAILED)
+    # Legal transitions; anything else is a programming error surfaced loudly.
+    TRANSITIONS = {
+        STATE_PENDING: (STATE_CANCELLING_JOBS, STATE_FAILED, STATE_COMPLETE),
+        STATE_CANCELLING_JOBS: (STATE_REAPING, STATE_FAILED),
+        STATE_REAPING: (STATE_COMPLETE, STATE_FAILED),
+        # failed deletions are resumable: a re-issued DELETE re-enters pending
+        STATE_FAILED: (STATE_PENDING,),
+        STATE_COMPLETE: (),
+    }
+
+    class Meta:
+        app_label = 'main'
+        ordering = ('-id',)
+
+    organization = models.ForeignKey(
+        'Organization',
+        related_name='deletions',
+        null=True,
+        on_delete=models.SET_NULL,
+        help_text=_('The organization being deleted; NULL once it is gone.'),
+    )
+    organization_id_snapshot = models.PositiveIntegerField(help_text=_('Stable id of the organization, kept after deletion.'))
+    organization_name = models.CharField(max_length=512, help_text=_('Name at deletion time, kept after deletion.'))
+    state = models.CharField(max_length=32, choices=STATES, default=STATE_PENDING)
+    progress = models.JSONField(default=dict, blank=True, help_text=_('Per-type deleted/cancelled counts.'))
+    error = models.TextField(blank=True, default='')
+    created = models.DateTimeField(auto_now_add=True)
+    modified = models.DateTimeField(auto_now=True)
+
+    def transition(self, new_state, error=''):
+        """Move to new_state, enforcing the transition table. Saves."""
+        allowed = self.TRANSITIONS.get(self.state, ())
+        if new_state not in allowed:
+            raise ValueError(f'illegal deletion transition {self.state} -> {new_state}')
+        self.state = new_state
+        if error:
+            self.error = error
+        self.save(update_fields=['state', 'error', 'modified'])
+
+    @property
+    def is_terminal(self):
+        return self.state in self.TERMINAL_STATES
+
+
+def child_deletion_plan():
+    """Ordered (label, queryset-factory) plan for reaping an organization.
+
+    Order matters: templates reference projects/inventories, so they go
+    first; teams and labels last; credentials and execution environments
+    CASCADE with the organization row itself. Jobs are history and are not
+    deleted (their resource FKs null out; tombstoning is increment 3).
+    Returns a list of (type_label, callable(org) -> queryset).
+    """
+    from awx.main.models import Inventory, JobTemplate, NotificationTemplate, Project, Team, WorkflowJobTemplate
+    from awx.main.models.label import Label
+
+    return [
+        ('workflow_job_templates', lambda org: WorkflowJobTemplate.objects.filter(organization=org)),
+        ('job_templates', lambda org: JobTemplate.objects.filter(models.Q(project__organization=org) | models.Q(inventory__organization=org))),
+        ('projects', lambda org: Project.objects.filter(organization=org)),
+        ('inventories', lambda org: Inventory.objects.filter(organization=org)),
+        ('notification_templates', lambda org: NotificationTemplate.objects.filter(organization=org)),
+        ('teams', lambda org: Team.objects.filter(organization=org)),
+        ('labels', lambda org: Label.objects.filter(organization=org)),
+    ]
diff --git a/awx/main/tasks/org_deletion.py b/awx/main/tasks/org_deletion.py
new file mode 100644
index 0000000..dd61572
--- /dev/null
+++ b/awx/main/tasks/org_deletion.py
@@ -0,0 +1,133 @@
+# Copyright (c) 2026 Automation Platform contributors
+# ADR-0001 increment 1: the reaper behind DELETE /api/v2/organizations/N/.
+#
+# Idempotent and resumable: every step re-derives state from the database, so
+# a crashed or re-dispatched run continues where the last one stopped instead
+# of leaving a half-deleted organization (the abort-on-first-409 failure class
+# this replaces).
+
+import logging
+import time
+
+from dispatcherd.publish import task
+
+from awx.main.constants import ACTIVE_STATES
+from awx.main.dispatch import get_task_queuename
+
+logger = logging.getLogger('awx.main.tasks.org_deletion')
+
+CANCEL_WAIT_SECONDS = 300
+CANCEL_POLL_SECONDS = 5
+
+
+def _active_jobs_for(org):
+    """Unified jobs still running that belong to the organization's estate."""
+    from django.db.models import Q
+
+    from awx.main.models import UnifiedJob
+
+    return UnifiedJob.objects.filter(
+        Q(unified_job_template__organization=org)
+        | Q(job__inventory__organization=org)
+        | Q(job__project__organization=org),
+        status__in=ACTIVE_STATES,
+    ).distinct()
+
+
+STUCK_AFTER_SECONDS = 600
+
+
+@task(queue=get_task_queuename, timeout=120, on_duplicate='discard')
+def process_organization_deletions():
+    """Periodic pump: dispatch a reaper for every deletion that needs one.
+
+    The web tier only writes the OrganizationDeletion row (it has no queue a
+    worker listens on — publishing from web goes nowhere, silently). This
+    runs on the task node via DISPATCH_SCHEDULE, so its local queuename is a
+    real worker queue. Picking work up from the database also makes crashed
+    reapers self-resuming: a deletion stuck in a non-terminal state past
+    STUCK_AFTER_SECONDS is simply dispatched again.
+    """
+    from datetime import timedelta
+
+    from django.utils import timezone
+
+    from awx.main.models.org_deletion import OrganizationDeletion
+
+    stale = timezone.now() - timedelta(seconds=STUCK_AFTER_SECONDS)
+    ready = OrganizationDeletion.objects.filter(state=OrganizationDeletion.STATE_PENDING)
+    stuck = OrganizationDeletion.objects.filter(
+        state__in=(OrganizationDeletion.STATE_CANCELLING_JOBS, OrganizationDeletion.STATE_REAPING), modified__lt=stale
+    )
+    for deletion in list(ready) + list(stuck):
+        logger.info('dispatching reaper for organization deletion %s (state=%s)', deletion.pk, deletion.state)
+        reap_organization.apply_async([deletion.pk], queue=get_task_queuename())
+
+
+@task(queue=get_task_queuename, timeout=1800, on_duplicate='queue_one')
+def reap_organization(deletion_id):
+    from awx.main.models.org_deletion import OrganizationDeletion, child_deletion_plan
+
+    try:
+        deletion = OrganizationDeletion.objects.get(pk=deletion_id)
+    except OrganizationDeletion.DoesNotExist:
+        logger.warning('organization deletion %s no longer exists', deletion_id)
+        return
+    if deletion.state == OrganizationDeletion.STATE_COMPLETE:
+        return
+    if deletion.state == OrganizationDeletion.STATE_FAILED:
+        # a re-dispatch of a failed deletion resumes it
+        deletion.transition(OrganizationDeletion.STATE_PENDING)
+
+    org = deletion.organization
+    if org is None:
+        # organization already gone: nothing left to do but say so
+        deletion.transition(OrganizationDeletion.STATE_COMPLETE)
+        return
+
+    progress = dict(deletion.progress or {})
+    try:
+        # Phase 1 — cancel active jobs, then wait (bounded) for them to settle.
+        if deletion.state == OrganizationDeletion.STATE_PENDING:
+            deletion.transition(OrganizationDeletion.STATE_CANCELLING_JOBS)
+        if deletion.state == OrganizationDeletion.STATE_CANCELLING_JOBS:
+            cancelled = 0
+            for uj in _active_jobs_for(org):
+                try:
+                    uj.cancel()
+                    cancelled += 1
+                except Exception:
+                    logger.exception('cancel of job %s during org deletion %s', uj.pk, deletion_id)
+            progress['jobs_cancelled'] = progress.get('jobs_cancelled', 0) + cancelled
+            deadline = time.monotonic() + CANCEL_WAIT_SECONDS
+            while _active_jobs_for(org).exists():
+                if time.monotonic() > deadline:
+                    raise RuntimeError(f'jobs still active after {CANCEL_WAIT_SECONDS}s of cancellation; re-issue the DELETE to resume')
+                time.sleep(CANCEL_POLL_SECONDS)
+            deletion.progress = progress
+            deletion.transition(OrganizationDeletion.STATE_REAPING)
+
+        # Phase 2 — delete children in dependency order, then the organization.
+        for label, qs_factory in child_deletion_plan():
+            count = 0
+            for obj in qs_factory(org).iterator():
+                obj.delete()
+                count += 1
+            if count:
+                progress[label] = progress.get(label, 0) + count
+                deletion.progress = progress
+                deletion.save(update_fields=['progress', 'modified'])
+        org.delete()
+        deletion.organization = None
+        deletion.save(update_fields=['organization', 'modified'])
+        deletion.transition(OrganizationDeletion.STATE_COMPLETE)
+        logger.info('organization %s (%s) deleted: %s', deletion.organization_id_snapshot, deletion.organization_name, progress)
+    except Exception as exc:
+        logger.exception('organization deletion %s failed', deletion_id)
+        deletion.progress = progress
+        try:
+            deletion.transition(OrganizationDeletion.STATE_FAILED, error=str(exc)[:5000])
+        except ValueError:
+            deletion.state = OrganizationDeletion.STATE_FAILED
+            deletion.error = str(exc)[:5000]
+            deletion.save(update_fields=['state', 'error', 'progress', 'modified'])

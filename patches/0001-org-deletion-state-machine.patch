index 0000000..14895c8
--- /dev/null
+++ b/awx/main/tests/unit/test_org_deletion.py
@@ -0,0 +1,59 @@
+"""Unit tests for ADR-0001 increment 1 (OrganizationDeletion state machine).
+
+Pure-logic coverage: the transition table and the child deletion plan's shape
+and order. DB behavior (reaper end-to-end) is covered by the platform's
+provider-conformance leak scan, which is the acceptance test the ADR names.
+"""
+
+import pytest
+
+from awx.main.models.org_deletion import OrganizationDeletion, child_deletion_plan
+
+
+def _unsaved(state):
+    d = OrganizationDeletion(organization_id_snapshot=1, organization_name='x', state=state)
+    # avoid touching the DB in a unit test
+    d.save = lambda *a, **k: None
+    return d
+
+
+def test_legal_transition_path():
+    d = _unsaved(OrganizationDeletion.STATE_PENDING)
+    d.transition(OrganizationDeletion.STATE_CANCELLING_JOBS)
+    d.transition(OrganizationDeletion.STATE_REAPING)
+    d.transition(OrganizationDeletion.STATE_COMPLETE)
+    assert d.is_terminal
+
+
+def test_illegal_transitions_raise():
+    d = _unsaved(OrganizationDeletion.STATE_PENDING)
+    with pytest.raises(ValueError):
+        d.transition(OrganizationDeletion.STATE_REAPING)
+    done = _unsaved(OrganizationDeletion.STATE_COMPLETE)
+    with pytest.raises(ValueError):
+        done.transition(OrganizationDeletion.STATE_PENDING)
+
+
+def test_failed_is_resumable_only_to_pending():
+    d = _unsaved(OrganizationDeletion.STATE_FAILED)
+    with pytest.raises(ValueError):
+        d.transition(OrganizationDeletion.STATE_REAPING)
+    d.transition(OrganizationDeletion.STATE_PENDING)
+    assert d.state == OrganizationDeletion.STATE_PENDING
+
+
+def test_transition_records_error():
+    d = _unsaved(OrganizationDeletion.STATE_REAPING)
+    d.transition(OrganizationDeletion.STATE_FAILED, error='boom')
+    assert d.error == 'boom' and d.is_terminal
+
+
+def test_child_plan_shape_and_order():
+    plan = child_deletion_plan()
+    labels = [label for label, _ in plan]
+    # templates must be reaped before the projects/inventories they reference
+    assert labels.index('workflow_job_templates') < labels.index('projects')
+    assert labels.index('job_templates') < labels.index('projects')
+    assert labels.index('job_templates') < labels.index('inventories')
+    # every entry is a callable factory
+    assert all(callable(f) for _, f in plan)

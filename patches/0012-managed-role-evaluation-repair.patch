+@pytest.mark.django_db
+def test_managed_role_sync_repairs_team_derived_view_evaluations(
+    user, organization, inventory, job_template, setup_managed_roles
+):
+    team = Team.objects.create(name='managed-role-repair-team', organization=organization)
+    team_member = user('managed-role-repair-user')
+    RoleDefinition.objects.get(name='Team Member').give_permission(team_member, team)
+
+    RoleDefinition.objects.get(name='Inventory Admin').give_permission(team, inventory)
+    RoleDefinition.objects.get(name='JobTemplate Execute').give_permission(team, job_template)
+    assert team_member.has_obj_perm(inventory, 'view')
+    assert team_member.has_obj_perm(job_template, 'view')
+
+    member_role_ids = team_member.role_assignments.values_list('object_role_id', flat=True)
+    RoleEvaluation.objects.filter(
+        role_id__in=member_role_ids,
+        codename='view_inventory',
+        object_id=inventory.pk,
+    ).delete()
+    RoleEvaluation.objects.filter(
+        role_id__in=member_role_ids,
+        codename='view_jobtemplate',
+        object_id=job_template.pk,
+    ).delete()
+    assert not team_member.has_obj_perm(inventory, 'view')
+    assert not team_member.has_obj_perm(job_template, 'view')
+
+    setup_managed_role_definitions(global_apps, None)
+
+    assert team_member.has_obj_perm(inventory, 'view')
+    assert team_member.has_obj_perm(inventory, 'change')
+    assert team_member.has_obj_perm(job_template, 'view')
+    assert team_member.has_obj_perm(job_template, 'execute')
+
+

+def test_reaper_yields_worker_while_job_cancellation_settles(monkeypatch):
+    class ActiveJob:
+        pk = 7
+        cancel_count = 0
+
+        def cancel(self):
+            self.cancel_count += 1
+
+    class ActiveJobs:
+        def __init__(self, job):
+            self.job = job
+
+        def __iter__(self):
+            return iter([self.job])
+
+        def exists(self):
+            return True
+
+    class Deletion:
+        pk = 3
+        state = OrganizationDeletion.STATE_CANCELLING_JOBS
+        organization = object()
+        progress = {}
+        saved_fields = None
+
+        def save(self, update_fields):
+            self.saved_fields = update_fields
+
+    deletion = Deletion()
+    job = ActiveJob()
+    active = ActiveJobs(job)
+
+    class FailIfWorkerSleeps:
+        monotonic = staticmethod(lambda: 0)
+        sleep = staticmethod(lambda seconds: pytest.fail('reaper held a dispatcherd worker'))
+
+    monkeypatch.setattr(OrganizationDeletion.objects, 'get', lambda pk: deletion)
+    monkeypatch.setattr(org_deletion, '_active_jobs_for', lambda org: active)
+    monkeypatch.setattr(org_deletion, 'time', FailIfWorkerSleeps, raising=False)
+
+    org_deletion.reap_organization(deletion.pk)
+
+    assert job.cancel_count == 1
+    assert deletion.state == OrganizationDeletion.STATE_CANCELLING_JOBS
+    assert deletion.saved_fields == ['progress', 'modified']

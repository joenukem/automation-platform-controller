From: Automation Platform controller <controller@pipefail.dev>
Subject: [PATCH 0020] translate managed credential type labels on a copy

Fixes F322. CredentialType.from_db assigns a managed credential type's
native.inputs to the instance BY REFERENCE, so the serializer's
value['inputs'] is the shared ManagedCredentialType.registry dict. The
serializer translated each managed field's label in place with gettext_lazy
and wrote the resulting lazy proxy back into that shared dict. The next
render wrapped that proxy once more, so every render added one nesting level
to the stored value; after a few hundred renders in one worker process
evaluating the proxy exhausted the interpreter's recursion limit and
/api/v2/credential_types/ answered HTTP 500.

Translate the labels on a copy instead, so the registry keeps exactly what
it was loaded with. The new unit test renders the same shared inputs fifty
times and asserts the stored labels are still plain strings.

Live acceptance: the controller's own readiness and liveness probes read
/api/v2/credential_types/ every 10s and 30s; they now read paths that
accumulate nothing, and a restarted controller answers the credential type
catalogue and the single Machine credential type with HTTP 200.

diff --git a/awx/api/serializers.py b/awx/api/serializers.py
index 1d5a26e..b57e6ad 100644
--- a/awx/api/serializers.py
+++ b/awx/api/serializers.py
@@ -2960,16 +2960,34 @@ class CredentialTypeSerializer(BaseSerializer):
         res['activity_stream'] = self.reverse('api:credential_type_activity_stream_list', kwargs={'pk': obj.pk})
         return res
 
+    @staticmethod
+    def _translate_managed_inputs(inputs):
+        """Translate a managed type's field labels on a COPY of its inputs.
+
+        A managed credential type's inputs ARE the shared registry object:
+        CredentialType.from_db assigns native.inputs by reference, so the
+        serializer's value['inputs'] is ManagedCredentialType.registry's dict.
+        Translating it in place wrote a gettext lazy proxy back into the
+        registry, and the next render wrapped that proxy once more. Every render
+        added one nesting level to the stored value, and after a few hundred
+        renders in one worker process Django's recursion limit was reached and
+        /api/v2/credential_types/ answered HTTP 500 (F322).
+        """
+        translated = copy.deepcopy(inputs) if isinstance(inputs, dict) else {}
+        for field in translated.get('fields', []):
+            if 'label' in field:
+                field['label'] = _(field['label'])
+            if 'help_text' in field:
+                field['help_text'] = _(field['help_text'])
+        return translated
+
     def to_representation(self, data):
         value = super(CredentialTypeSerializer, self).to_representation(data)
 
         # translate labels and help_text for credential fields "managed"
         if value.get('managed'):
             value['name'] = _(value['name'])
-            for field in value.get('inputs', {}).get('fields', []):
-                field['label'] = _(field['label'])
-                if 'help_text' in field:
-                    field['help_text'] = _(field['help_text'])
+            value['inputs'] = self._translate_managed_inputs(value.get('inputs'))
 
         # Deep copy inputs to avoid modifying the original model data
         inputs = value.get('inputs')
diff --git a/awx/main/tests/unit/api/serializers/test_credential_type_serializer.py b/awx/main/tests/unit/api/serializers/test_credential_type_serializer.py
new file mode 100644
index 0000000..223fddf
--- /dev/null
+++ b/awx/main/tests/unit/api/serializers/test_credential_type_serializer.py
@@ -0,0 +1,54 @@
+from django.utils.functional import Promise
+
+from awx.api.serializers import CredentialTypeSerializer
+
+
+def test_translate_managed_inputs_leaves_the_shared_registry_untouched():
+    """A managed credential type's inputs are the SHARED registry object.
+
+    CredentialType.from_db assigns native.inputs by reference, so the
+    serializer's value['inputs'] is ManagedCredentialType.registry's dict.
+    Translating it in place wrote a gettext lazy proxy back into the registry,
+    and the next render wrapped that proxy once more. Every render added one
+    nesting level to the stored value, and after a few hundred renders in one
+    worker process Django's recursion limit was reached and
+    /api/v2/credential_types/ answered HTTP 500 (F322).
+    """
+    shared = {
+        'fields': [
+            {'id': 'ssh_key_data', 'label': 'SSH Private Key', 'help_text': 'The private key'},
+            {'id': 'username', 'label': 'Username'},
+        ]
+    }
+
+    translated = CredentialTypeSerializer._translate_managed_inputs(shared)
+
+    # the registry keeps exactly what it was loaded with
+    assert shared['fields'][0]['label'] == 'SSH Private Key'
+    assert shared['fields'][0]['help_text'] == 'The private key'
+    assert shared['fields'][1]['label'] == 'Username'
+    for field in shared['fields']:
+        assert not isinstance(field.get('label'), Promise)
+        assert not isinstance(field.get('help_text'), Promise)
+
+    # and the copy carries the translated labels
+    assert str(translated['fields'][0]['label']) == 'SSH Private Key'
+    assert str(translated['fields'][0]['help_text']) == 'The private key'
+    assert str(translated['fields'][1]['label']) == 'Username'
+    assert translated['fields'][0] is not shared['fields'][0]
+
+
+def test_translate_managed_inputs_survives_repeated_renders():
+    """Repeated renders must not deepen the stored value.
+
+    Each render used to wrap the registry's label in one more lazy proxy, so
+    the nesting depth grew with every request until evaluation of the proxy
+    exhausted the interpreter's recursion limit.
+    """
+    shared = {'fields': [{'id': 'username', 'label': 'Username'}]}
+
+    for _ in range(50):
+        CredentialTypeSerializer._translate_managed_inputs(shared)
+
+    assert shared['fields'][0]['label'] == 'Username'
+    assert not isinstance(shared['fields'][0]['label'], Promise)

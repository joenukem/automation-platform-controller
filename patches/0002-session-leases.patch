+
+
+def test_expired_lease_exclusion_states_cover_all_nonterminal():
+    # the lease GC must not double-create deletions for orgs already in flight:
+    # its exclusion list must cover exactly the non-terminal states
+    non_terminal = {s for s, _ in OrganizationDeletion.STATES} - set(OrganizationDeletion.TERMINAL_STATES)
+    assert non_terminal == {
+        OrganizationDeletion.STATE_PENDING,
+        OrganizationDeletion.STATE_CANCELLING_JOBS,
+        OrganizationDeletion.STATE_REAPING,
+    }

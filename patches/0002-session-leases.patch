index dd61572..fbdab3a 100644
--- a/awx/main/tasks/org_deletion.py
+++ b/awx/main/tasks/org_deletion.py
@@ -54,7 +54,22 @@ def process_organization_deletions():
 
     from awx.main.models.org_deletion import OrganizationDeletion
 
-    stale = timezone.now() - timedelta(seconds=STUCK_AFTER_SECONDS)
+    from awx.main.models import Organization
+
+    now = timezone.now()
+    # Expired session leases become deletions like any other (jobs preserved).
+    expired = Organization.objects.filter(expires_at__isnull=False, expires_at__lt=now).exclude(
+        deletions__state__in=(
+            OrganizationDeletion.STATE_PENDING,
+            OrganizationDeletion.STATE_CANCELLING_JOBS,
+            OrganizationDeletion.STATE_REAPING,
+        )
+    )
+    for org in expired:
+        logger.info('organization %s (%s) lease expired at %s; scheduling deletion', org.pk, org.name, org.expires_at)
+        OrganizationDeletion.objects.create(organization=org, organization_id_snapshot=org.pk, organization_name=org.name)
+
+    stale = now - timedelta(seconds=STUCK_AFTER_SECONDS)
     ready = OrganizationDeletion.objects.filter(state=OrganizationDeletion.STATE_PENDING)
     stuck = OrganizationDeletion.objects.filter(
         state__in=(OrganizationDeletion.STATE_CANCELLING_JOBS, OrganizationDeletion.STATE_REAPING), modified__lt=stale

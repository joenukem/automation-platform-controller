new file mode 100644
index 0000000..82262f4
--- /dev/null
+++ b/awx/main/migrations/0210_inventory_org_not_null.py
@@ -0,0 +1,49 @@
+# ADR-0001 increment 3: adopt org-NULL strands, then make org-less inventories
+# unrepresentable at the database level. Project/WorkflowJobTemplate share
+# main_unifiedjobtemplate with JobTemplate (whose organization is legitimately
+# NULL), so their guarantee is operational (the deletion pump adopts strays)
+# rather than schema-level.
+from datetime import timedelta
+
+from django.db import migrations
+from django.utils import timezone
+
+RECOVERED_ORG_NAME = 'recovered-orphans'
+
+
+def adopt_orphans(apps, schema_editor):
+    Organization = apps.get_model('main', 'Organization')
+    Inventory = apps.get_model('main', 'Inventory')
+    Project = apps.get_model('main', 'Project')
+    WorkflowJobTemplate = apps.get_model('main', 'WorkflowJobTemplate')
+
+    def graveyard():
+        org = Organization.objects.filter(name=RECOVERED_ORG_NAME).first()
+        if org is None:
+            org = Organization.objects.create(
+                name=RECOVERED_ORG_NAME,
+                description='Adopted organization-less rows (ADR-0001 increment 3); lease-reaped.',
+                expires_at=timezone.now() + timedelta(days=30),
+            )
+        return org
+
+    org = None
+    for model in (Inventory, Project, WorkflowJobTemplate):
+        qs = model.objects.filter(organization__isnull=True)
+        if qs.exists():
+            org = org or graveyard()
+            qs.update(organization=org)
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ('main', '0209_organization_expires_at'),
+    ]
+
+    operations = [
+        migrations.RunPython(adopt_orphans, migrations.RunPython.noop),
+        migrations.RunSQL(
+            sql='ALTER TABLE main_inventory ALTER COLUMN organization_id SET NOT NULL;',
+            reverse_sql='ALTER TABLE main_inventory ALTER COLUMN organization_id DROP NOT NULL;',
+        ),
+    ]

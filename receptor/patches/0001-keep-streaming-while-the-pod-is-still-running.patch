+// reopenStdoutIfReplaced preserves a live results stream across work-unit
+// recovery. Recovery can briefly remove and recreate the stdout path while a
+// reader still owns the old inode. A missing path is transient; once a new
+// inode appears, return a handle for it so the caller can continue at the same
+// byte offset without replaying events.
+func reopenStdoutIfReplaced(stdout *os.File, stdoutFilename string) (*os.File, bool, error) {
+	currentInfo, err := stdout.Stat()
+	if err != nil {
+		return stdout, false, err
+	}
+	pathInfo, err := os.Stat(stdoutFilename)
+	if os.IsNotExist(err) {
+		return stdout, false, nil
+	}
+	if err != nil {
+		return stdout, false, err
+	}
+	if os.SameFile(currentInfo, pathInfo) {
+		return stdout, false, nil
+	}
+	replacement, err := os.Open(stdoutFilename)
+	if err != nil {
+		return stdout, false, err
+	}
+
+	return replacement, true, nil
+}

+// loggingContext keeps normal stream cancellation tied to the work unit. If that
+// context is already canceled during recovery, it returns a bounded independent
+// context so the status read or reconnect can still reach Kubernetes.
+func (kw *KubeUnit) loggingContext(recoveryTimeout time.Duration) (context.Context, context.CancelFunc) {
+	workContext := kw.GetContext()
+	if workContext != nil && workContext.Err() == nil {
+		return context.WithCancel(workContext)
+	}
+
+	return context.WithTimeout(context.Background(), recoveryTimeout)
+}
+
+func (kw *KubeUnit) podForLogging(podNamespace, podName string) (*corev1.Pod, error) {
+	ctx, cancel := kw.loggingContext(2 * time.Second)
+	defer cancel()
+
+	return KubeAPIWrapperInstance.Get(ctx, kw.clientset, podNamespace, podName, metav1.GetOptions{})
+}
+
+// podPhaseForLogging reports the pod's current phase, or an empty phase when it
+// cannot be read. It distinguishes "the pod finished, stop streaming" from "the
+// log stream broke while the pod is still producing output, keep reconnecting".
+func (kw *KubeUnit) podPhaseForLogging(podNamespace, podName string) corev1.PodPhase {
+	pod, err := kw.podForLogging(podNamespace, podName)
+	if err != nil || pod == nil {
+		return ""
+	}
+
+	return pod.Status.Phase
+}

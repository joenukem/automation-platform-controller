From: Automation Platform controller <controller@pipefail.dev>
Subject: [PATCH] retain stdout results across work-unit recovery

Fixes F306 on Receptor 1.6.7. A work-unit recovery can briefly remove and
recreate its stdout path while GetResults still owns the old inode. The fixed
three-second path watchdog treated that transition as fatal even while the
work unit remained active.

Keep the live descriptor while the path is absent. When recovery recreates the
path with a new inode, adopt it at the last delivered byte offset so events are
not replayed. Receptor 1.6.7 already contains the Kubernetes log reconnection
improvements that the earlier 1.4.8 patch carried, so this patch intentionally
contains only the remaining control-side result-reader fix.

diff --git a/pkg/workceptor/workceptor.go b/pkg/workceptor/workceptor.go
index 0614027..8d721b1 100644
--- a/pkg/workceptor/workceptor.go
+++ b/pkg/workceptor/workceptor.go
@@ -492,6 +492,34 @@ func sleepOrDone(doneChan <-chan struct{}, interval time.Duration) bool {
 	}
 }
 
+// reopenStdoutIfReplaced preserves a live results stream across work-unit
+// recovery. Recovery can briefly remove and recreate the stdout path while a
+// reader still owns the old inode. A missing path is transient; once a new
+// inode appears, return a handle for it so the caller can continue at the same
+// byte offset without replaying events.
+func reopenStdoutIfReplaced(stdout *os.File, stdoutFilename string) (*os.File, bool, error) {
+	currentInfo, err := stdout.Stat()
+	if err != nil {
+		return stdout, false, err
+	}
+	pathInfo, err := os.Stat(stdoutFilename)
+	if os.IsNotExist(err) {
+		return stdout, false, nil
+	}
+	if err != nil {
+		return stdout, false, err
+	}
+	if os.SameFile(currentInfo, pathInfo) {
+		return stdout, false, nil
+	}
+	replacement, err := os.Open(stdoutFilename)
+	if err != nil {
+		return stdout, false, err
+	}
+
+	return replacement, true, nil
+}
+
 // GetResults returns a live stream of the results of a unit.
 func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int64) (chan []byte, error) {
 	unit, err := w.findUnit(unitID)
@@ -508,7 +536,6 @@ func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int
 	unitdir := path.Join(w.dataDir, unitID)
 	stdoutFilename := path.Join(unitdir, "stdout")
 	var stdout *os.File
-	ctxChild, cancel := context.WithCancel(ctx)
 	go func() {
 		defer func() {
 			err = stdout.Close()
@@ -516,7 +543,6 @@ func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int
 				w.nc.GetLogger().Error("Error closing stdout %s", stdoutFilename)
 			}
 			resultClose()
-			cancel()
 		}()
 
 		// Wait for stdout file to exist
@@ -544,29 +570,6 @@ func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int
 			break
 		}
 		filePos := startPos
-		statChan := make(chan struct{}, 1)
-		go func() {
-			failures := 0
-			for {
-				select {
-				case <-ctxChild.Done():
-					return
-				case <-time.After(1 * time.Second):
-					_, err := os.Stat(stdoutFilename)
-					if os.IsNotExist(err) {
-						failures++
-						if failures > 3 {
-							w.nc.GetLogger().Error("Exceeded retries for reading stdout %s", stdoutFilename)
-							statChan <- struct{}{}
-
-							return
-						}
-					} else {
-						failures = 0
-					}
-				}
-			}
-		}()
 		for {
 			if sleepOrDone(ctx.Done(), 250*time.Millisecond) {
 				return
@@ -575,8 +578,6 @@ func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int
 				select {
 				case <-ctx.Done():
 					return
-				case <-statChan:
-					return
 				default:
 					var newPos int64
 					newPos, err = stdout.Seek(filePos, 0)
@@ -613,6 +614,16 @@ func (w *Workceptor) GetResults(ctx context.Context, unitID string, startPos int
 
 					return
 				}
+				replacement, replaced, reopenErr := reopenStdoutIfReplaced(stdout, stdoutFilename)
+				if reopenErr != nil {
+					w.nc.GetLogger().Warning("Could not inspect replacement stdout %s: %s", stdoutFilename, reopenErr)
+				} else if replaced {
+					if closeErr := stdout.Close(); closeErr != nil {
+						w.nc.GetLogger().Warning("Error closing replaced stdout %s: %s", stdoutFilename, closeErr)
+					}
+					stdout = replacement
+					w.nc.GetLogger().Info("Reopened replaced stdout %s at offset %d", stdoutFilename, filePos)
+				}
 			} else if err != nil {
 				w.nc.GetLogger().Error("Error reading stdout: %s\n", err)
 
diff --git a/pkg/workceptor/workceptor_stdout_test.go b/pkg/workceptor/workceptor_stdout_test.go
new file mode 100644
index 0000000..3f2fec5
--- /dev/null
+++ b/pkg/workceptor/workceptor_stdout_test.go
@@ -0,0 +1,64 @@
+package workceptor
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReopenStdoutIfReplacedWaitsWhilePathMissing(t *testing.T) {
+	stdoutFilename := filepath.Join(t.TempDir(), "stdout")
+	if err := os.WriteFile(stdoutFilename, []byte("first"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := os.Open(stdoutFilename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stdout.Close() })
+	if err := os.Remove(stdoutFilename); err != nil {
+		t.Fatal(err)
+	}
+
+	resolved, replaced, err := reopenStdoutIfReplaced(stdout, stdoutFilename)
+	if err != nil {
+		t.Fatalf("reopenStdoutIfReplaced() error = %v", err)
+	}
+	if replaced || resolved != stdout {
+		t.Fatal("missing path must retain the active stdout descriptor")
+	}
+}
+
+func TestReopenStdoutIfReplacedAdoptsRecreatedPath(t *testing.T) {
+	stdoutFilename := filepath.Join(t.TempDir(), "stdout")
+	if err := os.WriteFile(stdoutFilename, []byte("first"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := os.Open(stdoutFilename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stdout.Close() })
+	if err := os.Remove(stdoutFilename); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(stdoutFilename, []byte("replacement"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	resolved, replaced, err := reopenStdoutIfReplaced(stdout, stdoutFilename)
+	if err != nil {
+		t.Fatalf("reopenStdoutIfReplaced() error = %v", err)
+	}
+	if !replaced || resolved == stdout {
+		t.Fatal("recreated path must replace the stale stdout descriptor")
+	}
+	t.Cleanup(func() { _ = resolved.Close() })
+	payload, err := os.ReadFile(stdoutFilename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(payload) != "replacement" {
+		t.Fatalf("replacement payload = %q", payload)
+	}
+}

diff --git a/pkg/workceptor/kubernetes_stream_test.go b/pkg/workceptor/kubernetes_stream_test.go
new file mode 100644
index 0000000..eece5df
--- /dev/null
+++ b/pkg/workceptor/kubernetes_stream_test.go
@@ -0,0 +1,119 @@
+package workceptor
+
+import (
+	"context"
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+)
+
+type canceledContextBaseWorkUnit struct {
+	BaseWorkUnitForWorkUnit
+	ctx context.Context
+}
+
+func (b canceledContextBaseWorkUnit) GetContext() context.Context {
+	return b.ctx
+}
+
+type loggingPhaseKubeAPI struct {
+	KubeAPIer
+	t              *testing.T
+	expectedPhase  corev1.PodPhase
+	observedActive bool
+}
+
+func (k *loggingPhaseKubeAPI) Get(
+	ctx context.Context,
+	_ *kubernetes.Clientset,
+	_, _ string,
+	_ metav1.GetOptions,
+) (*corev1.Pod, error) {
+	if ctx.Err() != nil {
+		k.t.Fatalf("pod phase query inherited the canceled work context: %v", ctx.Err())
+	}
+	if _, ok := ctx.Deadline(); !ok {
+		k.t.Fatal("pod phase query has no timeout")
+	}
+	k.observedActive = true
+
+	return &corev1.Pod{Status: corev1.PodStatus{Phase: k.expectedPhase}}, nil
+}
+
+func TestPodPhaseForLoggingUsesIndependentContext(t *testing.T) {
+	previousAPI := KubeAPIWrapperInstance
+	t.Cleanup(func() {
+		KubeAPIWrapperInstance = previousAPI
+	})
+
+	workContext, cancelWork := context.WithCancel(context.Background())
+	cancelWork()
+	base := canceledContextBaseWorkUnit{ctx: workContext}
+	kw := &KubeUnit{BaseWorkUnitForWorkUnit: base}
+	fakeAPI := &loggingPhaseKubeAPI{t: t, expectedPhase: corev1.PodRunning}
+	KubeAPIWrapperInstance = fakeAPI
+
+	if phase := kw.podPhaseForLogging("jobs", "automation-job-15462"); phase != corev1.PodRunning {
+		t.Fatalf("podPhaseForLogging() = %q, want %q", phase, corev1.PodRunning)
+	}
+	if !fakeAPI.observedActive {
+		t.Fatal("pod phase query was not made")
+	}
+}
+
+func TestLoggingContextPreservesActiveWorkCancellation(t *testing.T) {
+	workContext, cancelWork := context.WithCancel(context.Background())
+	base := canceledContextBaseWorkUnit{ctx: workContext}
+	kw := &KubeUnit{BaseWorkUnitForWorkUnit: base}
+
+	loggingContext, cancelLogging := kw.loggingContext(time.Minute)
+	t.Cleanup(cancelLogging)
+	if loggingContext.Err() != nil {
+		t.Fatalf("logging context started canceled: %v", loggingContext.Err())
+	}
+	cancelWork()
+	if loggingContext.Err() != context.Canceled {
+		t.Fatalf("logging context error = %v, want %v", loggingContext.Err(), context.Canceled)
+	}
+}
+
+func TestLoggingContextDetachesCanceledWorkWithDeadline(t *testing.T) {
+	workContext, cancelWork := context.WithCancel(context.Background())
+	cancelWork()
+	base := canceledContextBaseWorkUnit{ctx: workContext}
+	kw := &KubeUnit{BaseWorkUnitForWorkUnit: base}
+
+	loggingContext, cancelLogging := kw.loggingContext(time.Minute)
+	t.Cleanup(cancelLogging)
+	if loggingContext.Err() != nil {
+		t.Fatalf("recovery context inherited cancellation: %v", loggingContext.Err())
+	}
+	deadline, ok := loggingContext.Deadline()
+	if !ok {
+		t.Fatal("recovery context has no deadline")
+	}
+	remaining := time.Until(deadline)
+	if remaining <= 0 || remaining > time.Minute {
+		t.Fatalf("recovery deadline remaining = %s, want within one minute", remaining)
+	}
+}
+
+func TestLoggingReadCloserCancelsOwnedContext(t *testing.T) {
+	streamContext, cancelStream := context.WithCancel(context.Background())
+	stream := &loggingReadCloser{
+		ReadCloser: io.NopCloser(strings.NewReader("")),
+		cancel:     cancelStream,
+	}
+
+	if err := stream.Close(); err != nil {
+		t.Fatalf("Close() error = %v", err)
+	}
+	if streamContext.Err() != context.Canceled {
+		t.Fatalf("stream context error = %v, want %v", streamContext.Err(), context.Canceled)
+	}
+}

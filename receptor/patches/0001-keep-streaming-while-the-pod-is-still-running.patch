+// podPhaseForLogging reports the pod's current phase, or an empty phase when it
+// cannot be read. It distinguishes "the pod finished, stop streaming" from "the
+// log stream broke while the pod is still producing output, keep reconnecting".
+func (kw *KubeUnit) podPhaseForLogging(podNamespace, podName string) corev1.PodPhase {
+	pod, err := KubeAPIWrapperInstance.Get(kw.GetContext(), kw.clientset, podNamespace, podName, metav1.GetOptions{})
+	if err != nil || pod == nil {
+		return ""
+	}
+
+	return pod.Status.Phase
+}
